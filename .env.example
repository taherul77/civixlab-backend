# --- Database (PostgreSQL 16) ---
# Connection string used by Prisma. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://civixlab:civixlab@localhost:5432/civixlab?schema=public"
DIRECT_DATABASE_URL="postgresql://civixlab:civixlab@localhost:5432/civixlab?schema=public"

# --- Redis 7.2 (sessions / rate limit / BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- JWT signing (NextAuth-compatible HS256 secret) ---
# Generate with: openssl rand -base64 64
JWT_SECRET="replace-me-with-a-64-byte-base64-secret"
JWT_TTL_SECONDS=3600

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Tenant isolation (RLS) ---
# Postgres role used at runtime; RLS policies key off `app.current_tenant`.
DB_APP_ROLE="civixlab_app"
